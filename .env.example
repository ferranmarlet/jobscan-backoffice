# Copy to .env.local and fill in.

# API the dev server proxies /api to
API_URL=http://localhost:8080

# Cognito sign-in, from `terraform -chdir=terraform output`
VITE_COGNITO_ISSUER_URI=https://cognito-idp.eu-west-1.amazonaws.com/<cognito_user_pool_id>
VITE_COGNITO_CLIENT_ID=<cognito_spa_client_id>
VITE_COGNITO_LOGIN_DOMAIN=<cognito_login_domain>
